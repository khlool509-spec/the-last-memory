; Engine configuration file.
; THE LAST MEMORY
;
; تحذير: Godot يعيد كتابة هذا الملف عند أول فتح للمشروع.
; لا تعدّله يدوياً بعد ذلك — استخدم Project Settings داخل المحرر.

config_version=5

[application]

config/name="THE LAST MEMORY"
config/description="لعبة مغامرات وغموض ثلاثية الأبعاد بمنظور الشخص الثالث، للأندرويد، فردية وتعمل دون اتصال."
config/version="0.13.0"
run/main_scene="res://levels/ch01_forest/forest_preview.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/textures/icon/icon_512.png"

[autoload]

Settings="*res://src/core/game_settings.gd"
Graphics="*res://src/core/graphics_manager.gd"
SaveSystem="*res://src/save_system/save_system.gd"
Router="*res://src/core/scene_router.gd"
Inv="*res://src/inventory/inventory.gd"
Goals="*res://src/story/objectives.gd"
Audio="*res://src/audio/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[rendering]

environment/defaults/default_clear_color=Color(0.027, 0.027, 0.039, 1)
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
mesh_lod/lod_change/threshold_pixels=8.0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=false
textures/default_filters/anisotropic_filtering_level=1
lights_and_shadows/directional_shadow/size.mobile=2048

[gui]

common/default_scroll_deadzone=28

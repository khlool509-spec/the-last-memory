; Engine configuration file.
; THE LAST MEMORY
;
; تحذير: Godot يعيد كتابة هذا الملف عند أول فتح للمشروع.
; لا تعدّله يدوياً بعد ذلك — استخدم Project Settings داخل المحرر.

config_version=5

[application]

config/name="THE LAST MEMORY"
config/description="لعبة مغامرات وغموض ثلاثية الأبعاد بمنظور الشخص الثالث، للأندرويد، فردية وتعمل دون اتصال."
config/version="0.6.1"
run/main_scene="res://src/ui/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/textures/icon/icon_512.png"

[autoload]

Settings="*res://src/core/game_settings.gd"
SaveSystem="*res://src/save_system/save_system.gd"
Router="*res://src/core/scene_router.gd"
Inv="*res://src/inventory/inventory.gd"
Goals="*res://src/story/objectives.gd"
Audio="*res://src/audio/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[rendering]

environment/defaults/default_clear_color=Color(0.027, 0.027, 0.039, 1)
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
mesh_lod/lod_change/threshold_pixels=4.0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/ssil/quality=2
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
textures/default_filters/anisotropic_filtering_level=4
